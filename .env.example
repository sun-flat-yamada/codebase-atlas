# =================================================================
# codebase-atlas - repository defaults for development tooling
# =================================================================
# Copy to `.env` (git-ignored) to override locally. Process environment variables
# take precedence over `.env`, which takes precedence over this file.

# Auto-Pilot (scripts/automerge.py; see docs/development-workflow.md)
# `true` = open pull requests ready for review (not as drafts) and, after the PR is
#          created, wait for CI, approve and Rebase & Merge automatically:
#            python3 scripts/automerge.py finish <pr> --wait
# Cloud sessions: set this in the cloud environment's variables to override this default.
# Anything else / unset = manual (draft PR, a human merges).
CHG_DEV_AUTO_PILOT=true

# graphify command used by tools/atlas_graph.py build (optional; default: `graphify` on PATH)
# GRAPHIFY_CMD=graphify
